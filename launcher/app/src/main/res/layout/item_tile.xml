<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tile"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/tile_gap">

    <app.anihome.launcher.ui.TileCardFrame
        android:id="@+id/card_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <FrameLayout
            android:id="@+id/card"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_card_fill"
            android:elevation="6dp"
            android:foreground="@drawable/bg_tile_glass">

            <ImageView
                android:id="@+id/icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                tools:src="@drawable/ic_tv" />

            <TextView
                android:id="@+id/monogram"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:textColor="@color/text"
                android:textSize="34sp"
                android:visibility="gone"
                tools:text="HA" />
        </FrameLayout>

        <View
            android:id="@+id/focus_ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_tile_focus"
            android:duplicateParentState="true" />

        <TextView android:id="@+id/notification_badge" android:layout_width="wrap_content" android:layout_height="28dp"
            android:layout_gravity="top|end" android:elevation="9dp" android:gravity="center"
            android:minWidth="44dp" android:paddingStart="12dp" android:paddingEnd="4dp" android:paddingBottom="7dp" android:textColor="#FFFFFF"
            android:textSize="11sp" android:textStyle="bold" android:visibility="gone" android:background="@drawable/bg_banner_notification_tag" />
        <ImageView
            android:id="@+id/remove"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-4dp"
            android:layout_marginEnd="-4dp"
            android:background="@drawable/bg_badge_remove"
            android:contentDescription="@string/action_remove"
            android:elevation="8dp"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            android:visibility="gone"
            tools:visibility="visible" />
    </app.anihome.launcher.ui.TileCardFrame>

    <TextView
        android:id="@+id/label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.AniHome.Tile"
        tools:text="Crunchyroll" />
</LinearLayout>
