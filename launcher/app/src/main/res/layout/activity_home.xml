<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_padding"
        android:paddingEnd="@dimen/page_padding" android:paddingBottom="88dp">

        <LinearLayout
            android:id="@+id/default_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/default_home_banner"
                android:textColor="@color/text"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_default_home"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/default_home_set"
                android:textColor="@color/cyan" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/home_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:clipToPadding="false">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:clipToPadding="false"
                    android:paddingTop="14dp"
                    tools:listitem="@layout/item_tile" />
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/widget_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:paddingBottom="24dp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <LinearLayout android:id="@+id/control_rail" android:layout_width="match_parent" android:layout_height="64dp"
        android:layout_gravity="bottom" android:layout_marginStart="@dimen/page_padding" android:layout_marginEnd="@dimen/page_padding" android:layout_marginBottom="@dimen/page_padding"
        android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_glass" android:padding="8dp">
        <ImageView android:id="@+id/rail_brand" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/anibrave_lion" android:contentDescription="@null" />
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="horizontal" android:gravity="center">
            <ImageButton android:id="@+id/btn_search" style="@style/Widget.AniHome.BorderlessIconButton" android:layout_marginStart="2dp" android:layout_marginEnd="2dp"
                android:src="@drawable/ic_google" android:contentDescription="@string/action_search" android:tooltipText="@string/action_search" android:visibility="visible" />
            <ImageButton android:id="@+id/btn_add" style="@style/Widget.AniHome.BorderlessIconButton" android:layout_marginStart="2dp" android:layout_marginEnd="2dp"
                android:src="@drawable/ic_add" android:contentDescription="@string/action_add" android:tooltipText="@string/action_add" android:visibility="visible" />
            <ImageButton android:id="@+id/btn_edit" style="@style/Widget.AniHome.BorderlessIconButton" android:layout_marginStart="2dp" android:layout_marginEnd="2dp"
                android:src="@drawable/ic_edit" android:contentDescription="@string/action_edit" android:tooltipText="@string/action_edit" android:visibility="gone" />
            <ImageButton android:id="@+id/btn_settings" style="@style/Widget.AniHome.BorderlessIconButton" android:layout_marginStart="2dp" android:layout_marginEnd="2dp"
                android:src="@drawable/ic_settings" android:contentDescription="@string/action_settings" android:tooltipText="@string/action_settings" android:visibility="gone" />
            <ImageButton android:id="@+id/btn_notifications" style="@style/Widget.AniHome.BorderlessIconButton" android:layout_marginStart="2dp" android:layout_marginEnd="2dp"
                android:src="@drawable/ic_notifications" android:contentDescription="@string/action_notifications" android:tooltipText="@string/action_notifications" android:visibility="gone" />
            <ImageButton android:id="@+id/btn_more" style="@style/Widget.AniHome.BorderlessIconButton" android:layout_marginStart="2dp" android:layout_marginEnd="2dp"
                android:src="@drawable/ic_more" android:contentDescription="@string/action_more" android:tooltipText="@string/action_more" android:visibility="visible" />
        </LinearLayout>
        <ImageButton android:id="@+id/btn_apps" style="@style/Widget.AniHome.BorderlessIconButton" android:src="@drawable/ic_apps" android:contentDescription="@string/action_all_apps" android:tooltipText="@string/action_all_apps" />
    </LinearLayout>

    <TextView
        android:id="@+id/empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="32dp"
        android:text="@string/empty_home"
        android:textColor="@color/muted"
        android:textSize="15sp"
        android:visibility="gone" />
</FrameLayout>
