<?xml version="1.0" encoding="utf-8"?>
<!-- Glass finish layered above a per-tile brand colour (set programmatically as the card tint). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#44FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#1FFFFFFF" android:endColor="#00FFFFFF" />
            <stroke android:width="1dp" android:color="@color/glass_line" />
            <corners android:radius="@dimen/tile_radius" />
        </shape>
    </item>
</ripple>
