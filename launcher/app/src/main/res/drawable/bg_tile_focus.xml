<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="150">
    <!-- Selected while the tile has keyboard / remote focus (set from code); tap feedback is the card's own ripple. -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <stroke android:width="3dp" android:color="#BCE2FF" />
            <corners android:radius="@dimen/tile_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/tile_radius" />
        </shape>
    </item>
</selector>
