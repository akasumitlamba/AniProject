<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.AniHome" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
        <item name="colorPrimary">@color/cyan</item>
        <item name="colorOnPrimary">@color/ink</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSurface">@color/ink_soft</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="materialAlertDialogTheme">@style/Theme.AniHome.Dialog</item>
    </style>

    <style name="Theme.AniHome.Popup" parent="ThemeOverlay.AppCompat.Dark">
        <item name="android:colorBackground">@color/ink_soft</item>
        <item name="android:popupBackground">@color/ink_soft</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text</item>
        <item name="popupMenuStyle">@style/Widget.AniHome.Popup</item>
    </style>
    <style name="Widget.AniHome.Popup" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@color/ink_soft</item>
    </style>

    <style name="Theme.AniHome.Web" parent="Theme.AniHome">
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:colorBackground">@color/ink</item>
    </style>

    <style name="Theme.AniHome.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/ink_soft</item>
        <item name="colorPrimary">@color/cyan</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.AniHome.Dialog</item>
    </style>

    <style name="ShapeAppearance.AniHome.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="Widget.AniHome.IconButton" parent="Widget.Material3.Button.IconButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:tint">@color/text</item>
    </style>

    <style name="Widget.AniHome.BorderlessIconButton" parent="Widget.AniHome.IconButton">
        <item name="android:background">@drawable/bg_icon_button</item>
    </style>

    <style name="TextAppearance.AniHome.Tile" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">13.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:shadowColor">#CC000000</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">6</item>
    </style>
    <style name="Theme.AniHome.Drawer" parent="Theme.AniHome">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/ink_soft</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowAnimationStyle">@style/Animation.AniHome.Drawer</item>
    </style>
    <style name="Animation.AniHome.Drawer" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/drawer_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/drawer_hold</item>
        <item name="android:activityCloseEnterAnimation">@anim/drawer_hold</item>
        <item name="android:activityCloseExitAnimation">@anim/drawer_exit</item>
    </style>
    <style name="Theme.AniHome.Home" parent="Theme.AniHome">
        <item name="android:windowFullscreen">true</item>
    </style>
    <style name="Theme.AniHome.Sidebar" parent="Theme.AniHome.Dialog">
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
